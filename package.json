{
  "name": "billflow",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client"
  ],
  "description": "BillFlow - Smart Invoice and GST Manager built with the MERN stack.",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "start": "node server/index.js",
    "seed": "node server/seed.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "json2csv": "^6.0.0-alpha.2",
    "mongoose": "^8.9.3",
    "morgan": "^1.10.0",
    "pdfkit": "^0.15.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "vite": "^6.0.7"
  }
}
